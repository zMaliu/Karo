<view class="page">
  <view class="modes">
    <view
      wx:for="{{modes}}"
      wx:key="key"
      class="mode {{mode === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onModeTap"
    >{{item.label}}</view>
  </view>

  <view class="card clock-card">
    <view class="row">
      <picker range="{{subjects}}" bindchange="onSubjectChange">
        <view class="subject">科目：{{subject}}</view>
      </picker>
      <text class="muted">{{status === 'idle' ? '未开始' : (status === 'paused' ? '已暂停' : '进行中')}}</text>
    </view>
    <view class="clock">{{clock}}</view>

    <view wx:if="{{status === 'idle'}}">
      <button class="btn-primary" loading="{{loading}}" bindtap="start">开始专注</button>
    </view>
    <view class="actions" wx:else>
      <button class="btn-ghost" bindtap="togglePause">{{status === 'paused' ? '继续' : '暂停'}}</button>
      <button class="btn-primary" bindtap="complete">完成</button>
      <button class="btn-ghost danger" bindtap="abort">放弃</button>
    </view>
  </view>

  <view class="card stats">
    <view class="stat">
      <view class="stat-value">{{todayText}}</view>
      <view class="muted">今日专注</view>
    </view>
    <view class="stat">
      <view class="stat-value">{{streak}} 天</view>
      <view class="muted">连续签到</view>
    </view>
    <view class="stat">
      <view class="stat-value">{{stats.total_checkin_days || 0}} 天</view>
      <view class="muted">累计签到</view>
    </view>
  </view>

  <view class="card" wx:if="{{stats}}">
    <view class="row"><text>今日完成会话</text><text class="muted">{{stats.session_count}} 次（有效 {{stats.valid_session_count}} 次）</text></view>
    <view class="row"><text>本周专注</text><text class="muted">{{stats.week_duration_sec}} 秒</text></view>
  </view>
</view>
