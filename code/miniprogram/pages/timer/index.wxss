.modes { display: flex; background: #fff; border-radius: 20rpx; padding: 8rpx; margin-bottom: 24rpx; }
.mode { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 14rpx; color: #6b7280; }
.mode.active { background: #2563eb; color: #fff; font-weight: 600; }
.clock-card { text-align: center; }
.subject { color: #2563eb; }
.clock { font-size: 96rpx; font-weight: 700; letter-spacing: 4rpx; margin: 48rpx 0; font-variant-numeric: tabular-nums; }
.actions { display: flex; gap: 20rpx; }
.actions button { flex: 1; }
.danger { color: #dc2626; background: #fef2f2; }
.stats { display: flex; justify-content: space-between; text-align: center; }
.stat-value { font-size: 34rpx; font-weight: 600; margin-bottom: 8rpx; }
