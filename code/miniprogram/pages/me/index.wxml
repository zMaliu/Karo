<view class="page">
  <view class="card head">
    <view class="avatar">{{initial}}</view>
    <view class="info">
      <view class="name">{{user.nickname || '未设置昵称'}}</view>
      <view class="muted">{{user.grade || '未填年级'}}{{user.major ? ' · ' + user.major : ''}}</view>
      <view class="muted">目标：{{user.goal || '还没设置备考目标'}}</view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <text>昵称</text>
      <text wx:if="{{!editing}}" class="muted" bindtap="startEdit">{{user.nickname || '点击设置'}} 〉</text>
    </view>
    <view class="edit-row" wx:if="{{editing}}">
      <input class="input" maxlength="20" value="{{nickname}}" bindinput="onNicknameInput" />
      <button class="btn-primary mini" loading="{{saving}}" bindtap="save">保存</button>
    </view>
    <view class="row"><text>手机号</text><text class="muted">{{user.phone}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">画像摘要</view>
    <view class="tags" wx:if="{{profile.personality.length}}">
      <text class="tag" wx:for="{{profile.personality}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="muted" wx:else>画像未完成，完成 25 题问卷后这里会展示性格/习惯标签</view>
    <view class="muted version">问卷版本：{{profile.questionnaire_version}}</view>
  </view>

  <view class="card">
    <view class="section-title">隐私设置</view>
    <view class="row">
      <text>公开在线状态</text>
      <switch checked="{{profile.privacy.show_online}}" data-key="show_online" color="#2563eb" bindchange="togglePrivacy" />
    </view>
    <view class="row">
      <text>个性化推荐</text>
      <switch checked="{{profile.privacy.personalized_rec}}" data-key="personalized_rec" color="#2563eb" bindchange="togglePrivacy" />
    </view>
    <view class="row">
      <text>推送通知</text>
      <switch checked="{{profile.privacy.push_enabled}}" data-key="push_enabled" color="#2563eb" bindchange="togglePrivacy" />
    </view>
  </view>

  <view class="card logout" bindtap="logout"><text>退出登录</text></view>
</view>
