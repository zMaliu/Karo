<view class="page">
  <view class="card hero">
    <view class="title">{{title}}</view>
    <view class="muted">{{subtitle}}</view>
  </view>

  <view class="card">
    <view class="empty">{{emptyText}}</view>
    <button class="btn-primary" bindtap="onPrimaryTap">{{actionText}}</button>
  </view>

  <view class="card">
    <view class="section-title">待接接口（骨架 501）</view>
    <view class="endpoint muted" wx:for="{{apiList}}" wx:key="path">{{item.method}} {{item.path}}</view>
  </view>
</view>
