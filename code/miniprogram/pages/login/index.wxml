<view class="login">
  <view class="brand">
    <view class="logo">K</view>
    <view class="title">Karo</view>
    <view class="muted">专注学习，从这里开始</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="field">
      <text class="label">验证码</text>
      <input class="input" type="number" maxlength="6" placeholder="6 位验证码" value="{{code}}" bindinput="onCodeInput" />
      <button class="btn-ghost send" size="mini" disabled="{{countdown > 0}}" bindtap="sendCode">
        {{countdown > 0 ? countdown + 's 后重发' : '获取验证码'}}
      </button>
    </view>
    <view class="dev muted" wx:if="{{devCode}}">开发环境验证码：{{devCode}}</view>
    <button class="btn-primary submit" loading="{{loading}}" bindtap="login">登录 / 注册</button>
    <checkbox-group bindchange="onAgreeChange">
      <label class="agree muted">
        <checkbox value="1" checked="{{agreed}}" color="#2563eb" />已阅读并同意《用户协议》与《隐私政策》
      </label>
    </checkbox-group>
  </view>
</view>
