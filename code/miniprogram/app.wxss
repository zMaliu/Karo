page { background: #f5f6fa; color: #1f2937; font-size: 28rpx; font-family: -apple-system, "PingFang SC", sans-serif; }
.page { padding: 32rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.muted { color: #6b7280; font-size: 24rpx; }
.btn-primary { background: #2563eb; color: #fff; border-radius: 16rpx; font-size: 30rpx; }
.btn-ghost { background: #eef2ff; color: #2563eb; border-radius: 16rpx; font-size: 30rpx; }
.btn-primary::after, .btn-ghost::after { border: none; }
